# Optional: without a key LeadHub still runs, using its built-in rule-based qualifier and reply templates.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Optional: hot leads are posted here (Slack "Incoming Webhook" URL). Empty = shown in the dashboard + console only.
SLACK_WEBHOOK_URL=

# 1 = real timing (follow-ups after 1, 3 and 7 days). 1440 = one "day" passes every minute (for demos).
TIME_SPEED=1440

# true = first replies wait for a human to approve them; false = sent immediately (simulated outbox)
REQUIRE_APPROVAL=false
PORT=7788
